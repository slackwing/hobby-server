<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
        User profile fields (2026-09-17), all set by the admin in the
        console (no user-facing profile page yet):

          - initial: 1-3 chars shown in the user's circular avatar.
          - color:   #rrggbb avatar background; assigned at random when
                     the admin creates the user, changeable via picker.
          - email:   optional; lets the console send templated emails
                     (invite, welcome — templates live in each site's
                     _email/ directory in the feathers repo).

        Existing rows get the first letter of their display name and a
        hash-derived colour so nothing is blank.
    -->

    <changeSet id="004-user-profile" author="admin">

        <addColumn tableName="hobby_server_user">
            <column name="initial" type="VARCHAR(3)" defaultValue="">
                <constraints nullable="false"/>
            </column>
            <column name="color" type="VARCHAR(7)" defaultValue="#4a7fa0">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(254)"/>
        </addColumn>

        <sql>
            UPDATE hobby_server_user
               SET initial = UPPER(LEFT(display_name, 1))
             WHERE initial = '';
            UPDATE hobby_server_user
               SET color = '#' || SUBSTR(MD5(username), 1, 6);
        </sql>

    </changeSet>

</databaseChangeLog>
