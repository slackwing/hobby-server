<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
        Claims (Andrew, 2026-09-22): "This is me!" — a third stamp kind,
        claim, one per member (a new claim releases the old one) and one
        per card (a claimed card refuses others). It prints the member's
        name in the card's lower-right corner like a passport stamp, so
        the row keeps the name as it was printed (label).
    -->

    <changeSet id="018-claims" author="hxh">
        <addColumn tableName="hxh_stamp">
            <column name="label" type="VARCHAR(80)" defaultValue="">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
