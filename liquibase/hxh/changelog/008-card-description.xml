<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!--
        card_description (Andrew, 2026-09-19): the short text printed in
        a Greed Island card's description box — separate from the longer
        profile description, and part of what gets reviewed.
    -->

    <changeSet id="008-card-description" author="hxh">
        <addColumn tableName="hxh_char">
            <column name="card_description" type="TEXT" defaultValue="">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
